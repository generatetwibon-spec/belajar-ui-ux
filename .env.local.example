# Environment Variables untuk SIAGA POSKO App
# Salin file ini ke .env.local dan isi dengan kredensial Supabase Anda

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Dapatkan nilai ini dari: https://app.supabase.com
# Project Settings → API → Project URL & anon key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# CARA SETUP SUPABASE:
# ============================================================
# 1. Buat akun di https://supabase.com
# 2. Buat project baru
# 3. Buka SQL Editor → paste konten dari supabase/schema.sql
# 4. Run → semua tabel + seed data akan terbuat
# 5. Copy Project URL dan anon key ke file .env.local ini
# 6. Restart dev server: npm run dev
#
# CATATAN: Jika .env.local TIDAK dikonfigurasi, aplikasi tetap
# berjalan penuh dengan mock data lokal (React state).
# ============================================================
